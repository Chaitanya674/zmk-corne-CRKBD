#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Layer";
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp ESC   &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp LGUI
                  &kp LCTRL &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };

                lower_layer {
                        display-name = "Lower Layer";
                        bindings = <
   &kp CAPS  &kp N1   &kp UP   &kp N3    &kp N4       &kp N5         &kp N1   &kp N2   &kp N3 &kp N0    &kp RPAR &kp BSPC
   &kp DEL   &kp LEFT &kp DOWN &kp RIGHT &bt BT_SEL 3 &bt BT_SEL 4   &kp N4   &kp N5   &kp N6 &kp TILDE &kp BSLH &trans
   &kp LSHFT &trans   &trans   &trans    &kp C_VOL_DN &kp C_VOL_UP   &kp N7   &kp N8   &kp N9 &kp GRAVE &kp PIPE &kp LGUI
                                    &kp LCTRL    &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
                        display-name = "Raise Layer";
                        bindings = <
   &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET            &kp AMPS             &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &kp F1   &kp F2 &kp F3   &kp F4   &kp F5      &kp MINUS            &kp EQUAL             &trans    &kp LBKT &kp RBKT &kp GRAVE
   &kp LSHFT &kp F6   &kp F7 &kp F8   &kp F9   &kp F11     &kp C_BRIGHTNESS_INC &kp C_BRIGHTNESS_DEC   &trans    &kp LBRC &kp RBRC &kp TILDE
                             &kp LCTRL &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };

                rgb_layer {
                        display-name = "RGB Layer";
                        bindings = <
   &trans          &trans          &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans          &trans
   &rgb_ug RGB_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_BRD   &rgb_ug RGB_BRI &rgb_ug RGB_EFR &rgb_ug RGB_EFF &rgb_ug RGB_SPD &rgb_ug RGB_SPI &trans
   &trans          &trans          &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans          &trans
                                    &trans          &trans          &trans            &trans          &trans          &trans
                        >;
                };
        };
};