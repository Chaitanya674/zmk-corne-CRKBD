/*
 * LEFT HALF — 1.3" OLED
 *
 * A 1.3" I2C OLED module is almost always an SH1106 controller at 128x64.
 * ZMK's stock corne.dtsi declares a 128x32 SSD1306, so the SSD1306 driver
 * was talking to an SH1106: the SH1106 ignores SSD1306's horizontal
 * addressing command, so the framebuffer never lands where the driver
 * thinks it does, and `inversion-on` turns every untouched pixel ON.
 * That is your solid blue panel.
 *
 * IF YOUR 1.3" PANEL IS ACTUALLY ON THE RIGHT HALF, swap the contents of
 * this file and corne_right.overlay.
 */

&oled {
    compatible = "sinowealth,sh1106";
    reg = <0x3c>;
    width = <128>;
    height = <64>;

    /* SH1106 has 132 columns of RAM driving a 128-column panel, so the
     * visible area starts 2 columns in. Leaving this at 0 shifts the image
     * sideways and wraps the edge. */
    segment-offset = <2>;

    page-offset = <0>;
    display-offset = <0>;
    multiplex-ratio = <63>;
    segment-remap;
    com-invdir;
    prechargep = <0x22>;

    /* 64-row panels use alternating COM pins, not sequential. */
    /delete-property/ com-sequential;

    /* Normal polarity: 0 = dark, 1 = lit. */
    /delete-property/ inversion-on;
};
